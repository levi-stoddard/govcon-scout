# Copy to .env and fill in. Every value here is a placeholder; .env is gitignored.
# Only SAM_API_KEY is needed for live scans. The offline test suite needs none of these.

# --- LLM (optional; used only by the Advisor chat and when USE_LLM=true) ---
# Gemini API key from Google AI Studio
GOOGLE_API_KEY=your-gemini-api-key
# Gemini model name used by the Advisor and the optional narrative layer
GEMINI_MODEL=gemini-2.5-flash
# Print CrewAI agent traces when the optional LLM layer runs (true/false)
CREW_VERBOSE=true

# --- SAM.gov ---
# Public API key from your SAM.gov account (Account Details -> API Key)
SAM_API_KEY=your-sam-gov-api-key

# --- Supplier pricing (optional; blank falls back to estimated costs, capped at VERIFY_COST) ---
# Grainger product API key
GRAINGER_API_KEY=
# Zoro product API key
ZORO_API_KEY=
# Google Programmable Search API key used for supplier price lookups
GOOGLE_CSE_API_KEY=your-google-cse-api-key
# Google Programmable Search engine ID
GOOGLE_CSE_ID=your-search-engine-id

# --- Shipping (optional; blank uses the built-in flat-rate table) ---
# USPS Web Tools user ID for live rates
USPS_USER_ID=
# Ship-from street address used for shipping estimates
SHIPPER_STREET=123 Example St
# Ship-from city
SHIPPER_CITY=Anytown
# Ship-from two-letter state code
SHIPPER_STATE=ST
# Ship-from ZIP code
SHIPPER_ZIP=00000
# Ship-from phone number (digits only)
SHIPPER_PHONE=5555550100

# --- Pipeline behavior ---
# Enable the optional LLM narrative layer; numbers and verdicts stay deterministic either way
USE_LLM=false
# Max opportunities per scan whose full SAM.gov description is fetched (each costs quota)
SAM_DESC_FETCH_LIMIT=5
# Set-asides you are eligible for, comma separated (SBA,WOSB,EDWOSB,8A,HZC,SDVOSBC)
MY_ELIGIBLE_SETASIDES=SBA
# Optional: margin below which a lead is always NO-GO (fraction, default 0.12)
# HARD_FLOOR_MARGIN_PCT=0.12
# Optional: let the daily hunter auto-track qualifying GO leads (true/false)
# HUNTER_AUTO_TRACK=true

# --- Email digest (optional; Gmail needs an App Password) ---
# SMTP server host
SMTP_HOST=smtp.gmail.com
# SMTP server port (587 for STARTTLS)
SMTP_PORT=587
# SMTP login user
SMTP_USER=you@example.com
# SMTP password or app password
SMTP_PASS=your-app-password
# Recipient for the daily digest (defaults to SMTP_USER)
DIGEST_TO=you@example.com

# --- Company profile for generated quote sheets ---
# Legal business name
COMPANY_NAME=Example Supply LLC
# CAGE code from SAM.gov registration
COMPANY_CAGE=XXXXX
# Unique Entity ID from SAM.gov registration
COMPANY_UEI=XXXXXXXXXXXX
# Point of contact name
COMPANY_POC=Your Name
# Contact email printed on quotes
COMPANY_EMAIL=you@example.com
# Contact phone printed on quotes
COMPANY_PHONE=5555550100
